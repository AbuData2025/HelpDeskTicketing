@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="status-page text-center">
    <h1 class="status-code">Oops</h1>
    <h2>Something went wrong</h2>
    <p class="text-muted">
        An unexpected error occurred while processing your request. Please try again in a moment.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Reference ID: <code>@Model.RequestId</code></p>
    }

    <a asp-page="/Index" class="btn btn-primary">Back to Home</a>
</div>