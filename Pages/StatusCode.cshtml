@page "{code:int}"
@model HelpDeskTicketing.Pages.StatusCodeModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="status-page text-center">
    <h1 class="status-code">@Model.Code</h1>
    <h2>@Model.Title</h2>
    <p class="text-muted">@Model.Message</p>
    <a asp-page="/Index" class="btn btn-primary">Back to Home</a>
</div>