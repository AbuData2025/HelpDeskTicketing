@page
@model HelpDeskTicketing.Pages.Admin.ManageUsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<h1>Manage Users</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Current Roles</th>
            <th>Assign Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>
                    @foreach (var role in user.Roles)
                    {
                        <form method="post" asp-page-handler="RemoveRole" style="display:inline" class="me-1">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <input type="hidden" name="role" value="@role" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove role">
                                @role &times;
                            </button>
                        </form>
                    }
                </td>
                <td>
                    <form method="post" asp-page-handler="AssignRole" style="display:inline">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <select name="role" class="form-select form-select-sm d-inline" style="width:auto">
                            @foreach (var role in Model.AllRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Add</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>