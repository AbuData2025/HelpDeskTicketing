@page
@model HelpDeskTicketing.Pages.Tickets.MyTicketsModel
@{
    ViewData["Title"] = "My Tickets";
}

<h1>My Tickets</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Submit a New Ticket</a>
</p>

@if (!Model.Tickets.Any())
{
    <div class="card p-4 text-center">
        <p class="mb-0 text-muted">You haven't submitted any tickets yet. Hit the button above to log your first one.</p>
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Submitted</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model.Tickets)
            {
                <tr>
                    <td><a asp-page="./Details" asp-route-id="@ticket.Id">@ticket.Title</a></td>
                    <td>@ticket.Category</td>
                    <td><span class="badge-pill @HelpDeskTicketing.Helpers.TicketStyleHelpers.PriorityBadgeClass(ticket.Priority)">@ticket.Priority</span></td>
                    <td><span class="badge-pill @HelpDeskTicketing.Helpers.TicketStyleHelpers.StatusBadgeClass(ticket.Status)">@ticket.Status</span></td>
                    <td>@ticket.CreatedAt.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}