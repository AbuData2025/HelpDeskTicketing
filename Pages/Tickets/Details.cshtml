@page "{id:int}"
@model HelpDeskTicketing.Pages.Tickets.DetailsModel
@{
    ViewData["Title"] = "Ticket Details";
}

<h1>@Model.Ticket.Title</h1>

<dl class="row">
    <dt class="col-sm-2">Submitted By</dt>
    <dd class="col-sm-10">@Model.Ticket.SubmittedByUser?.FullName</dd>

    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Ticket.Category</dd>

    <dt class="col-sm-2">Priority</dt>
    <dd class="col-sm-10"><span class="badge-pill @HelpDeskTicketing.Helpers.TicketStyleHelpers.PriorityBadgeClass(Model.Ticket.Priority)">@Model.Ticket.Priority</span></dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10"><span class="badge-pill @HelpDeskTicketing.Helpers.TicketStyleHelpers.StatusBadgeClass(Model.Ticket.Status)">@Model.Ticket.Status</span></dd>

    <dt class="col-sm-2">SLA</dt>
    <dd class="col-sm-10">@Html.Raw(HelpDeskTicketing.Helpers.TicketStyleHelpers.SlaBadge(Model.Ticket))</dd>

    <dt class="col-sm-2">Assigned To</dt>
    <dd class="col-sm-10">@(Model.Ticket.AssignedToUser?.FullName ?? "Unassigned")</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Ticket.Description</dd>
</dl>

<h3>Activity</h3>
<ul class="list-unstyled">
    @foreach (var activity in Model.Activities)
    {
        <li class="mb-2">
            <i class="ti ti-clock text-muted me-1"></i>
            <span>@activity.Description</span>
            <small class="text-muted">
                — @activity.ActorUser?.FullName, @activity.CreatedAt.ToLocalTime().ToString("g")
            </small>
        </li>
    }
</ul>

<hr />

<h3>Comments</h3>

@if (!Model.Comments.Any())
{
    <p class="text-muted">No comments yet.</p>
}
else
{
    foreach (var comment in Model.Comments)
    {
        <div class="card mb-2">
            <div class="card-body">
                <p class="mb-1">@comment.Body</p>
                <small class="text-muted">
                    @comment.AuthorUser?.FullName — @comment.CreatedAt.ToLocalTime().ToString("g")
                </small>
            </div>
        </div>
    }
}

<form method="post" asp-page-handler="AddComment" asp-route-id="@Model.Ticket.Id" class="mt-3">
    <div class="form-floating mb-3">
        <textarea asp-for="NewCommentBody" class="form-control" style="height: 100px" placeholder="Add a comment"></textarea>
        <label asp-for="NewCommentBody">Add a comment</label>
    </div>
    <button type="submit" class="btn btn-primary">Post Comment</button>
</form>